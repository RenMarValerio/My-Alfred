# Postgres (dev local via docker-compose)
DATABASE_URL="postgresql://karen:karen@localhost:5432/karen?schema=public"

NODE_ENV=development

# Intervalo (ms) do loop técnico do worker que dispara o poller de timeouts.
# Não confundir com os timeouts de negócio (timeout_lembrete_min / timeout_abandono_h),
# que ficam na tabela `configuracao_geral` do banco, não aqui.
POLLER_INTERVALO_MS=30000
